@* Chat message display component *@
@inject IJSRuntime JS

<div class="flex @(IsOwn ? "justify-end" : "justify-start") message-enter">
    <div class="max-w-[80%] @(IsRelevant ? "message-relevant" : "") @(IsWarning ? "message-warning" : "")">
        <div class="rounded-2xl px-4 py-2 @GetMessageStyles()">
            @if (Type == MessageType.AI)
            {
                <div class="text-xs text-blue-600 font-medium mb-1 flex items-center">
                    <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    AI Asistent
                </div>
            }
            else if (Type == MessageType.System)
            {
                <div class="text-xs text-gray-500 font-medium mb-1">Systém</div>
            }

            <div class="prose prose-sm max-w-none @(IsOwn ? "prose-invert" : "")">
                @((MarkupString)FormattedContent)
            </div>
        </div>

        <div class="text-xs text-gray-400 mt-1 @(IsOwn ? "text-right" : "") flex items-center @(IsOwn ? "justify-end" : "")">
            @Timestamp.ToLocalTime().ToString("H:mm")
            @if (IsRelevant)
            {
                <span class="text-green-500 ml-2 flex items-center">
                    <svg class="w-3 h-3 mr-0.5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    pokrok
                </span>
            }
            @if (IsWarning)
            {
                <span class="text-orange-500 ml-2 flex items-center">
                    <svg class="w-3 h-3 mr-0.5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                    </svg>
                    off-topic
                </span>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Content { get; set; } = string.Empty;

    [Parameter]
    public MessageType Type { get; set; } = MessageType.User;

    [Parameter]
    public bool IsOwn { get; set; }

    [Parameter]
    public bool IsRelevant { get; set; }

    [Parameter]
    public bool IsWarning { get; set; }

    [Parameter]
    public DateTime Timestamp { get; set; }

    [Parameter]
    public string? SenderName { get; set; }

    private string FormattedContent => FormatContent(Content);

    private string GetMessageStyles()
    {
        if (IsOwn) return "bg-blue-600 text-white";
        if (Type == MessageType.AI) return "bg-white border-2 border-blue-200";
        if (Type == MessageType.System) return "bg-gray-200 text-gray-700";
        return "bg-white shadow-sm";
    }

    private string FormatContent(string content)
    {
        // Basic HTML escaping
        content = System.Web.HttpUtility.HtmlEncode(content);

        // Math expressions: $...$ -> KaTeX span
        content = System.Text.RegularExpressions.Regex.Replace(content,
            @"\$\$(.*?)\$\$",
            "<span class=\"katex-display\" data-math=\"$1\"></span>");
        content = System.Text.RegularExpressions.Regex.Replace(content,
            @"\$(.*?)\$",
            "<span class=\"katex-inline\" data-math=\"$1\"></span>");

        // Code blocks: ```...``` -> pre/code
        content = System.Text.RegularExpressions.Regex.Replace(content,
            @"```(\w*)\n?([\s\S]*?)```",
            "<pre class=\"bg-gray-800 text-gray-100 p-2 rounded overflow-x-auto my-2 text-sm\"><code class=\"language-$1\">$2</code></pre>");

        // Inline code: `...` -> code
        content = System.Text.RegularExpressions.Regex.Replace(content,
            @"`([^`]+)`",
            "<code class=\"bg-gray-100 px-1 rounded text-sm\">$1</code>");

        // Bold: **...**
        content = System.Text.RegularExpressions.Regex.Replace(content, @"\*\*(.*?)\*\*", "<strong>$1</strong>");

        // Italic: *...*
        content = System.Text.RegularExpressions.Regex.Replace(content, @"\*(.*?)\*", "<em>$1</em>");

        // Line breaks
        content = content.Replace("\n", "<br/>");

        return content;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Trigger KaTeX and Prism rendering
            await JS.InvokeVoidAsync("renderMath");
            await JS.InvokeVoidAsync("highlightCode");
        }
    }
}
