@page "/"

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">
            Sledování pokroku studentů v reálném čase
        </h1>
        <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
            Vytvářejte skupiny, definujte cíle a sledujte, jak vaši studenti plní zadané úkoly.
            AI asistent pomáhá studentům a upozorní vás, když potřebují pomoc.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <AuthorizeView>
                <Authorized>
                    <a href="/teacher/dashboard" class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-lg text-lg font-medium inline-flex items-center justify-center">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                        </svg>
                        Přejít na Dashboard
                    </a>
                </Authorized>
                <NotAuthorized>
                    <a href="/auth/google-login" class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-lg text-lg font-medium inline-flex items-center justify-center">
                        <svg class="w-5 h-5 mr-2" viewBox="0 0 24 24">
                            <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                            <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                            <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                            <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                        </svg>
                        Přihlásit jako učitel
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>

    <!-- Features -->
    <div class="mt-20 grid md:grid-cols-3 gap-8">
        <div class="bg-white p-6 rounded-xl shadow-sm border">
            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Snadné připojení</h3>
            <p class="text-gray-600">
                Studenti se připojí pomocí QR kódu nebo krátkého kódu. Žádná registrace, stačí zadat přezdívku.
            </p>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-sm border">
            <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Real-time sledování</h3>
            <p class="text-gray-600">
                Sledujte pokrok všech studentů v reálném čase. Progress bary a checkmarky ukazují stav plnění cílů.
            </p>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-sm border">
            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">AI asistent</h3>
            <p class="text-gray-600">
                Umělá inteligence navádí studenty, detekuje pokrok a upozorní vás, když někdo potřebuje pomoc.
            </p>
        </div>
    </div>

    <!-- How it works -->
    <div class="mt-20">
        <h2 class="text-2xl font-bold text-gray-900 text-center mb-12">Jak to funguje?</h2>
        <div class="grid md:grid-cols-4 gap-6">
            <div class="text-center">
                <div class="w-10 h-10 bg-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 font-bold">1</div>
                <h4 class="font-medium text-gray-900 mb-2">Vytvořte skupinu</h4>
                <p class="text-sm text-gray-600">Zadejte název a definujte cíle, které mají studenti splnit.</p>
            </div>
            <div class="text-center">
                <div class="w-10 h-10 bg-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 font-bold">2</div>
                <h4 class="font-medium text-gray-900 mb-2">Sdílejte QR kód</h4>
                <p class="text-sm text-gray-600">Studenti naskenují QR kód a zadají svou přezdívku.</p>
            </div>
            <div class="text-center">
                <div class="w-10 h-10 bg-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 font-bold">3</div>
                <h4 class="font-medium text-gray-900 mb-2">Studenti pracují</h4>
                <p class="text-sm text-gray-600">AI asistent je navádí a analyzuje jejich postup.</p>
            </div>
            <div class="text-center">
                <div class="w-10 h-10 bg-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 font-bold">4</div>
                <h4 class="font-medium text-gray-900 mb-2">Sledujte pokrok</h4>
                <p class="text-sm text-gray-600">Vidíte stav všech studentů a kdo potřebuje pomoc.</p>
            </div>
        </div>
    </div>
</div>
