@page "/teacher/dashboard"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IGroupService GroupService
@inject AuthenticationStateProvider AuthStateProvider

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Dashboard</h1>
            <p class="text-gray-600">Přehled vašich skupin a aktivních studentů</p>
        </div>
        <a href="/teacher/groups/create" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium inline-flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Nová skupina
        </a>
    </div>

    @if (_loading)
    {
        <div class="flex justify-center py-12">
            <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
        </div>
    }
    else if (_groups.Count == 0)
    {
        <div class="bg-white rounded-xl shadow-sm border p-12 text-center">
            <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            <h3 class="text-lg font-medium text-gray-900 mb-2">Zatím nemáte žádné skupiny</h3>
            <p class="text-gray-600 mb-6">Vytvořte svou první skupinu a začněte sledovat pokrok studentů.</p>
            <a href="/teacher/groups/create" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-medium inline-flex items-center">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Vytvořit skupinu
            </a>
        </div>
    }
    else
    {
        <!-- Stats -->
        <div class="grid md:grid-cols-4 gap-4 mb-8">
            <div class="bg-white rounded-xl shadow-sm border p-6">
                <div class="text-sm text-gray-500 mb-1">Skupiny celkem</div>
                <div class="text-3xl font-bold text-gray-900">@_groups.Count</div>
            </div>
            <div class="bg-white rounded-xl shadow-sm border p-6">
                <div class="text-sm text-gray-500 mb-1">Aktivní skupiny</div>
                <div class="text-3xl font-bold text-green-600">@_groups.Count(g => g.IsActive)</div>
            </div>
            <div class="bg-white rounded-xl shadow-sm border p-6">
                <div class="text-sm text-gray-500 mb-1">Celkem studentů</div>
                <div class="text-3xl font-bold text-blue-600">@_groups.Sum(g => g.Members.Count)</div>
            </div>
            <div class="bg-white rounded-xl shadow-sm border p-6">
                <div class="text-sm text-gray-500 mb-1">Potřebují pomoc</div>
                <div class="text-3xl font-bold text-orange-500">@_groups.Sum(g => g.Members.Count(m => m.NeedsHelp))</div>
            </div>
        </div>

        <!-- Groups table -->
        <div class="bg-white rounded-xl shadow-sm border overflow-hidden">
            <div class="px-6 py-4 border-b">
                <h2 class="text-lg font-semibold text-gray-900">Vaše skupiny</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Název</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Studenti</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cíle</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Stav</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Vytvořeno</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Akce</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var group in _groups)
                        {
                            var needsHelp = group.Members.Count(m => m.NeedsHelp);
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="font-medium text-gray-900">@group.Name</div>
                                    <div class="text-sm text-gray-500">@group.JoinCode</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <span class="text-gray-900">@group.Members.Count</span>
                                        @if (needsHelp > 0)
                                        {
                                            <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                                                @needsHelp potřebuje pomoc
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-gray-500">
                                    @group.Goals.Count cílů
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (group.IsActive)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                            Aktivní
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                            Ukončená
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    @group.CreatedAt.ToLocalTime().ToString("d. M. yyyy H:mm")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                    <a href="/teacher/groups/@group.Id/monitor" class="text-blue-600 hover:text-blue-900 mr-3">
                                        Sledovat
                                    </a>
                                    <a href="/teacher/groups/@group.Id" class="text-gray-600 hover:text-gray-900">
                                        Detail
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<Group> _groups = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst("UserId")?.Value;

        // Fallback: get user by email if UserId claim is not present
        if (string.IsNullOrEmpty(userId))
        {
            var email = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
            if (!string.IsNullOrEmpty(email))
            {
                var user = await GroupService.GetUserByEmailAsync(email);
                userId = user?.Id;
            }
        }

        if (!string.IsNullOrEmpty(userId))
        {
            _groups = await GroupService.GetGroupsByOwnerAsync(userId);
        }

        _loading = false;
    }
}
