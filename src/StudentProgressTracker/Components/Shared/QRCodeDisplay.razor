@* QR Code display component *@

<div class="qr-code-container text-center">
    @if (!string.IsNullOrEmpty(QRCodeBase64))
    {
        <img src="@QRCodeBase64" alt="QR Code" class="w-@(Size) h-@(Size) mx-auto mb-4" />
    }
    else
    {
        <div class="w-@(Size) h-@(Size) bg-gray-100 flex items-center justify-center mx-auto mb-4 rounded">
            <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
            </svg>
        </div>
    }

    @if (!string.IsNullOrEmpty(JoinCode))
    {
        <div>
            <p class="text-sm text-gray-500 mb-1">Kód pro připojení:</p>
            <p class="text-2xl font-mono font-bold text-blue-600 tracking-wider">@JoinCode</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(JoinUrl))
    {
        <div class="mt-3">
            <p class="text-xs text-gray-400">nebo otevřete:</p>
            <code class="text-xs bg-gray-100 px-2 py-1 rounded break-all">@JoinUrl</code>
        </div>
    }
</div>

@code {
    [Parameter]
    public string? QRCodeBase64 { get; set; }

    [Parameter]
    public string? JoinCode { get; set; }

    [Parameter]
    public string? JoinUrl { get; set; }

    [Parameter]
    public int Size { get; set; } = 48;
}
