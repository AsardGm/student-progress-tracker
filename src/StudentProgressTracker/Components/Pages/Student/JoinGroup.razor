@page "/join/{JoinCode}"
@page "/join"
@layout StudentProgressTracker.Components.Layout.EmptyLayout
@rendermode InteractiveServer
@inject IGroupService GroupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="min-h-screen bg-gradient-to-b from-blue-50 to-white flex items-center justify-center px-4">
    <div class="max-w-md w-full">
        @if (_step == Step.EnterCode)
        {
            <div class="bg-white rounded-2xl shadow-lg p-8">
                <div class="text-center mb-8">
                    <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                    </div>
                    <h1 class="text-2xl font-bold text-gray-900 mb-2">Připojit se ke skupině</h1>
                    <p class="text-gray-600">Zadejte kód skupiny od učitele</p>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Kód skupiny</label>
                        <input type="text" @bind="_joinCode" @bind:event="oninput" maxlength="6"
                               class="w-full px-4 py-3 text-center text-2xl font-mono font-bold tracking-widest border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 uppercase"
                               placeholder="ABC123" />
                    </div>

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="bg-red-50 text-red-600 px-4 py-3 rounded-lg text-sm">
                            @_error
                        </div>
                    }

                    <button @onclick="CheckCode" disabled="@(_checking || _joinCode.Length < 6)"
                            class="w-full bg-blue-600 hover:bg-blue-700 disabled:opacity-50 text-white font-medium py-3 rounded-xl transition-colors">
                        @if (_checking)
                        {
                            <span class="inline-flex items-center">
                                <svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-white" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                Hledám...
                            </span>
                        }
                        else
                        {
                            <span>Pokračovat</span>
                        }
                    </button>
                </div>
            </div>
        }
        else if (_step == Step.EnterNickname)
        {
            <div class="bg-white rounded-2xl shadow-lg p-8">
                <div class="text-center mb-8">
                    <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                    <h1 class="text-2xl font-bold text-gray-900 mb-2">@_group?.Name</h1>
                    <p class="text-gray-600">Zadej svou přezdívku</p>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Přezdívka</label>
                        <input type="text" @bind="_nickname" maxlength="50"
                               class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               placeholder="např. Honza Novák" />
                    </div>

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="bg-red-50 text-red-600 px-4 py-3 rounded-lg text-sm">
                            @_error
                        </div>
                    }

                    <button @onclick="JoinGroupAsync" disabled="@(_joining || string.IsNullOrWhiteSpace(_nickname))"
                            class="w-full bg-green-600 hover:bg-green-700 disabled:opacity-50 text-white font-medium py-3 rounded-xl transition-colors">
                        @if (_joining)
                        {
                            <span class="inline-flex items-center">
                                <svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-white" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                Připojuji...
                            </span>
                        }
                        else
                        {
                            <span>Připojit se</span>
                        }
                    </button>

                    <button @onclick="() => _step = Step.EnterCode" class="w-full text-gray-500 hover:text-gray-700 text-sm">
                        ← Zpět
                    </button>
                </div>
            </div>
        }
        else if (_step == Step.AlreadyJoined)
        {
            <div class="bg-white rounded-2xl shadow-lg p-8 text-center">
                <div class="w-16 h-16 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <h1 class="text-2xl font-bold text-gray-900 mb-2">Už jsi ve skupině</h1>
                <p class="text-gray-600 mb-6">Z tohoto zařízení už jsi se do skupiny připojil/a.</p>
                <button @onclick="ContinueToChat" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 rounded-xl transition-colors">
                    Pokračovat do chatu
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string? JoinCode { get; set; }

    private enum Step { EnterCode, EnterNickname, AlreadyJoined }
    private Step _step = Step.EnterCode;

    private string _joinCode = "";
    private string _nickname = "";
    private string _error = "";
    private string _deviceId = "";
    private bool _checking;
    private bool _joining;
    private bool _initialized;
    private Group? _group;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(JoinCode))
        {
            _joinCode = JoinCode.ToUpper();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            // Generate or retrieve device ID - must be in OnAfterRenderAsync for JS interop
            _deviceId = await JS.InvokeAsync<string>("getOrCreateDeviceId");

            if (!string.IsNullOrEmpty(_joinCode) && _joinCode.Length >= 6)
            {
                await CheckCode();
                StateHasChanged();
            }
        }
    }

    private async Task CheckCode()
    {
        if (_joinCode.Length < 6) return;

        _checking = true;
        _error = "";

        try
        {
            _group = await GroupService.GetGroupByJoinCodeAsync(_joinCode.ToUpper());

            if (_group == null)
            {
                _error = "Skupina s tímto kódem neexistuje.";
            }
            else if (!_group.IsActive)
            {
                _error = "Tato skupina už není aktivní.";
            }
            else
            {
                // Check if device already joined
                var hasJoined = await GroupService.HasDeviceJoinedGroupAsync(_group.Id, _deviceId);
                if (hasJoined)
                {
                    _step = Step.AlreadyJoined;
                }
                else
                {
                    _step = Step.EnterNickname;
                }
            }
        }
        catch (Exception)
        {
            _error = "Nastala chyba při hledání skupiny.";
        }
        finally
        {
            _checking = false;
        }
    }

    private async Task JoinGroupAsync()
    {
        if (string.IsNullOrWhiteSpace(_nickname) || _group == null) return;

        _joining = true;
        _error = "";

        try
        {
            var member = await GroupService.JoinGroupAsync(_group.Id, _deviceId, _nickname.Trim());

            // Store member info in localStorage
            await JS.InvokeVoidAsync("setGroupMemberInfo", _group.Id.ToString(), member.Id.ToString(), _nickname);

            Navigation.NavigateTo($"/student/chat/{_group.Id}");
        }
        catch (Exception)
        {
            _error = "Nepodařilo se připojit ke skupině.";
        }
        finally
        {
            _joining = false;
        }
    }

    private void ContinueToChat()
    {
        if (_group != null)
        {
            Navigation.NavigateTo($"/student/chat/{_group.Id}");
        }
    }
}
